# ─── API Keys ─────────────────────────────────────────────
# API-Football (https://www.api-football.com) — free tier: 100 req/day
FOOTBALL_API_KEY=

# OpenWeatherMap (https://openweathermap.org/api) — free tier: 1000 req/day
WEATHER_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey) — for AI narrative engine
GEMINI_API_KEY=

# ─── App Config ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# World Cup 2026 tournament ID on API-Football
NEXT_PUBLIC_WC_LEAGUE_ID=1
NEXT_PUBLIC_WC_SEASON=2026

# ─── Feature Flags ────────────────────────────────────────
# Live data is used by default when API keys are present.
# Set to 'true' only if you want to force mock/fallback behaviour.
NEXT_PUBLIC_USE_MOCK_DATA=false
