# ─── API Keys ─────────────────────────────────────────────
# API-Football (https://www.api-football.com) — free tier: 100 req/day
FOOTBALL_API_KEY=your_api_football_key_here
FOOTBALL_API_HOST=v3.football.api-sports.io

# OpenWeatherMap (https://openweathermap.org/api) — free tier: 1000 req/day
WEATHER_API_KEY=your_openweathermap_key_here

# Anthropic Claude (https://console.anthropic.com) — for AI tactical explainer + narrative engine
ANTHROPIC_API_KEY=your_anthropic_key_here

# ─── App Config ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# World Cup 2026 tournament ID on API-Football
# Check by calling: GET /leagues?name=FIFA World Cup&season=2026
NEXT_PUBLIC_WC_LEAGUE_ID=1
NEXT_PUBLIC_WC_SEASON=2026

# ─── Feature Flags ────────────────────────────────────────
# Set to 'true' to use mock data instead of live API (for dev without API key)
NEXT_PUBLIC_USE_MOCK_DATA=true
